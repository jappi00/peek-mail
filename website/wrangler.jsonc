// Landing page for Peek Mail, served as static assets from a Worker.
// Deploy from this folder: npx wrangler deploy
{
  "name": "peekmail-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "peekmail.oesterl.ing", "custom_domain": true }
  ],
  "workers_dev": false
}
